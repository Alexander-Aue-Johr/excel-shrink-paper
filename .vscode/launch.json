            "preLaunchTask": "py:bootstrap",
            "args": [
                "C:/Users/aue-johr/Downloads/old_downloads/data_gov_3nd_dl",
                "C:/Users/aue-johr/Downloads/old_downloads/data_gov_3nd_dl_s",
                "--out",
                "C:/Users/aue-johr/Downloads/old_downloads/data_gov_3nd_dl_s"
            ]
        },
        {
            "name": "Why Different?",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scrape_data_gov_xlsx_files/compare_file_hashes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "C:/Users/aue-johr/Downloads/old_downloads/diff/A",
                "C:/Users/aue-johr/Downloads/old_downloads/diff/B",
                "--out",
                "C:/Users/aue-johr/Downloads/old_downloads/diff/diff"
            ]
        },
        {
            "name": "Compare values of shrunk data.gov with original (test)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scape-data-gov-xlsx-files/compare_file_hashes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
