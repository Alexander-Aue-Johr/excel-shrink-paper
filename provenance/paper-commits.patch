@@ -0,0 +1,381 @@
+"""Run Excel in an owned process, with deadlines outside COM."""
+
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import time
+from typing import Any, Dict, Optional
+import zipfile
+
+
+class ExcelInfrastructureError(RuntimeError):
+    """Excel could not start; retrying every workbook would hide a host problem."""
+
+    def __init__(self, message: str, details: Optional[Dict[str, Any]] = None):
+        super().__init__(message)
+        self.details = details or {}
+
+
+def _write_json(path: Path, value: Dict[str, Any]) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    for attempt in range(30):
+        try:
+            os.replace(str(temporary), str(path))
+            return
+        except PermissionError:
+            if attempt == 29:
+                raise
+            time.sleep(0.01)
+
+
+def _read_json(path: Path) -> Dict[str, Any]:
+    try:
+        return json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return {}
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _is_xlsx(path: Path) -> bool:
+    """Use the package type, not the filename extension."""
+    try:
+        with zipfile.ZipFile(path) as archive:
+            content_types = archive.read("[Content_Types].xml")
+            return (
+                b"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"
+                in content_types
+                and "xl/workbook.xml" in archive.namelist()
+            )
+    except (OSError, KeyError, zipfile.BadZipFile):
+        return False
+
+
+def _check_xlsx(path: Path) -> Optional[str]:
+    if not _is_xlsx(path):
+        return "Excel did not produce an XLSX workbook."
+    try:
+        with zipfile.ZipFile(path) as archive:
+            bad_member = archive.testzip()
+        if bad_member:
+            return "The XLSX package has an invalid CRC: " + bad_member
+    except (OSError, RuntimeError, zipfile.BadZipFile) as error:
+        return "The XLSX package could not be read: " + str(error)
+    return None
+
+
+def _create_seed(path: Path) -> None:
+    """A blank workbook gives /x an EXCEL7 window before opening untrusted input."""
+    parts = {
+        "[Content_Types].xml": '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>',
+        "_rels/.rels": '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>',
+        "xl/workbook.xml": '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets></workbook>',
+        "xl/_rels/workbook.xml.rels": '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>',
+        "xl/worksheets/sheet1.xml": '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData/></worksheet>',
+    }
+    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as archive:
+        for name, contents in parts.items():
+            archive.writestr(name, contents)
+
+
+def _excel_executable() -> Path:
+    if os.name != "nt":
+        raise ExcelInfrastructureError("Excel conversion requires Windows and Microsoft Excel.")
+    import winreg
+
+    key_name = r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\excel.exe"
+    for hive in (winreg.HKEY_LOCAL_MACHINE, winreg.HKEY_CURRENT_USER):
+        for view in (winreg.KEY_WOW64_64KEY, winreg.KEY_WOW64_32KEY):
+            try:
+                with winreg.OpenKey(hive, key_name, 0, winreg.KEY_READ | view) as key:
+                    path = Path(winreg.QueryValueEx(key, "")[0])
+                if path.is_file():
+                    return path
+            except OSError:
+                pass
+    raise ExcelInfrastructureError("Microsoft Excel is not registered on this computer.")
+
+
+def preflight() -> Dict[str, str]:
+    executable = _excel_executable()
+    powershell = shutil.which("powershell.exe")
+    if powershell is None:
+        raise ExcelInfrastructureError("Windows PowerShell is not available.")
+    return {"excel_executable": str(executable), "powershell_executable": powershell}
+
+
+def _owned_handle(record: Dict[str, Any], access: int):
+    """A PID alone is insufficient: process IDs can be reused."""
+    if os.name != "nt" or not record.get("pid") or not record.get("created_filetime"):
+        return None
+    from ctypes import wintypes
+
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+    kernel.OpenProcess.restype = wintypes.HANDLE
+    kernel.GetProcessTimes.argtypes = [wintypes.HANDLE] + [ctypes.POINTER(wintypes.FILETIME)] * 4
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    handle = kernel.OpenProcess(access | 0x1000, False, int(record["pid"]))
+    if not handle:
+        return None
+    times = [wintypes.FILETIME() for _ in range(4)]
+    if not kernel.GetProcessTimes(handle, *(ctypes.byref(value) for value in times)):
+        kernel.CloseHandle(handle)
+        return None
+    created = (times[0].dwHighDateTime << 32) | times[0].dwLowDateTime
+    if created != int(record["created_filetime"]):
+        kernel.CloseHandle(handle)
+        return None
+    return handle
+
+
+def _terminate_owned(record: Dict[str, Any]) -> bool:
+    handle = _owned_handle(record, 0x0001)
+    if not handle:
+        return False
+    from ctypes import wintypes
+
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.TerminateProcess.argtypes = [wintypes.HANDLE, wintypes.UINT]
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    try:
+        return bool(kernel.TerminateProcess(handle, 124))
+    finally:
+        kernel.CloseHandle(handle)
+
+
+def _dialog_evidence(record: Dict[str, Any]) -> Dict[str, Any]:
+    """Inspect only the owned Excel process; do not capture the user's desktop."""
+    handle = _owned_handle(record, 0)
+    if not handle:
+        return {"windows": []}
+    from ctypes import wintypes
+
+    user = ctypes.WinDLL("user32", use_last_error=True)
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    callback_type = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
+    user.EnumWindows.argtypes = [callback_type, wintypes.LPARAM]
+    user.EnumChildWindows.argtypes = [wintypes.HWND, callback_type, wintypes.LPARAM]
+    user.GetWindowThreadProcessId.argtypes = [wintypes.HWND, ctypes.POINTER(wintypes.DWORD)]
+    user.GetClassNameW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
+    user.GetWindowTextW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
+    user.IsWindowVisible.argtypes = [wintypes.HWND]
+    windows = []
+
+    def describe(window):
+        caption = ctypes.create_unicode_buffer(1024)
+        class_name = ctypes.create_unicode_buffer(128)
+        user.GetWindowTextW(window, caption, len(caption))
+        user.GetClassNameW(window, class_name, len(class_name))
+        return {"class": class_name.value, "title": caption.value,
+                "visible": bool(user.IsWindowVisible(window))}
+
+    @callback_type
+    def collect(window, unused):
+        process_id = wintypes.DWORD()
+        user.GetWindowThreadProcessId(window, ctypes.byref(process_id))
+        if process_id.value != int(record["pid"]):
+            return True
+        details = describe(window)
+        if details["class"] == "#32770":
+            children = []
+
+            @callback_type
+            def child(window_child, unused_child):
+                if len(children) < 100:
+                    item = describe(window_child)
+                    if item["class"].lower() != "edit":
+                        children.append(item)
+                return True
+
+            user.EnumChildWindows(window, child, 0)
+            details["controls"] = children
+        windows.append(details)
+        return True
+
+    try:
+        user.EnumWindows(collect, 0)
+        return {"pid": record["pid"], "windows": windows}
+    finally:
+        kernel.CloseHandle(handle)
+
+
+def _run_worker(command, directory: Path, stage_timeout: float,
+                total_timeout: float) -> Dict[str, Any]:
+    """Keep the deadlines outside PowerShell and all COM calls."""
+    stage_file = directory / "stage.json"
+    result_file = directory / "result.json"
+    process_file = directory / "process.json"
+    start = time.monotonic()
+    stage_start = start
+    stage = "startup"
+    creation_flags = subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0
+    with (directory / "worker.log").open("wb") as log:
+        try:
+            worker = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT,
+                                      stdin=subprocess.DEVNULL, creationflags=creation_flags)
+        except OSError as error:
+            raise ExcelInfrastructureError("The Excel worker could not start: " + str(error)) from error
+        timed_out = None
+        try:
+            while worker.poll() is None:
+                state = _read_json(stage_file)
+                current_stage = state.get("stage", stage)
+                if current_stage != stage:
+                    stage, stage_start = current_stage, time.monotonic()
+                now = time.monotonic()
+                if now - start >= total_timeout:
+                    timed_out = "total_timeout"
+                elif now - stage_start >= stage_timeout:
+                    timed_out = "stage_timeout"
+                if timed_out:
+                    _write_json(directory / "windows.json", _dialog_evidence(_read_json(process_file)))
+                    break
+                time.sleep(0.1)
+        finally:
+            if worker.poll() is None:
+                worker.terminate()
+                try:
+                    worker.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    worker.kill()
+                    worker.wait(timeout=5)
+            # Killing PowerShell closes the job handle; this birth-checked fallback
+            # also covers a worker that exited without its normal cleanup.
+            _terminate_owned(_read_json(process_file))
+    elapsed = time.monotonic() - start
+    state = _read_json(stage_file)
+    stage = state.get("stage", stage)
+    if timed_out:
+        return {"status": "review", "reason": timed_out, "stage": stage,
+                "elapsed_seconds": elapsed, "process": _read_json(process_file),
+                "error": "Excel exceeded the configured deadline; the cause is not yet known."}
+    result = _read_json(result_file)
+    if not result:
+        result = {"status": "review", "reason": "worker_failed", "stage": stage,
+                  "error": "The worker exited without a result. See worker.log."}
+    result["elapsed_seconds"] = elapsed
+    result["worker_exit_code"] = worker.returncode
+    result["process"] = _read_json(process_file)
+    return result
+
+
+def _invoke_phase(mode: str, source: Path, output: Path, directory: Path,
+                  executable: Path, stage_timeout: float, total_timeout: float) -> Dict[str, Any]:
+    directory.mkdir(parents=True, exist_ok=True)
+    config = {
+        "mode": mode, "source": str(source.resolve()), "output": str(output.resolve()),
+        "excel": str(executable), "directory": str(directory.resolve()),
+        "seed": str((directory / "seed.xlsx").resolve()),
+    }
+    _create_seed(directory / "seed.xlsx")
+    _write_json(directory / "config.json", config)
+    powershell = shutil.which("powershell.exe")
+    if powershell is None:
+        raise ExcelInfrastructureError("Windows PowerShell is not available.")
+    command = [powershell, "-NoLogo", "-NoProfile", "-NonInteractive", "-STA",
+               "-ExecutionPolicy", "Bypass", "-File", str(Path(__file__).with_name("excel_worker.ps1")),
+               "-ConfigPath", str(directory / "config.json")]
+    try:
+        result = _run_worker(command, directory, stage_timeout, total_timeout)
+    finally:
+        (directory / "seed.xlsx").unlink(missing_ok=True)
+    if result.get("status") != "accepted" and result.get("stage") in ("startup", "configure"):
+        raise ExcelInfrastructureError("Excel failed during " + result.get("stage", "startup") +
+                                       ". See " + str(directory / "worker.log"), result)
+    return result
+
+
+def convert_file(source: Path, destination: Path, attempt_dir: Path,
+                 stage_timeout: float = 120, total_timeout: float = 360,
+                 *, force_save: bool = False) -> Dict[str, Any]:
+    """Convert without changing the source, then reopen in a fresh Excel process.
+
+    Accepted means that this Excel installation opened the output without a
+    blocking dialog under the recorded settings. It is not a fidelity claim.
+    Keep attempt_dir on the data drive, with a short path for legacy Excel.
+    """
+    source, destination, attempt_dir = Path(source), Path(destination), Path(attempt_dir)
+    if stage_timeout <= 0 or total_timeout <= 0:
+        raise ValueError("Timeouts must be positive.")
+    executable = _excel_executable()
+    if not source.is_file():
+        raise FileNotFoundError(source)
+    if len(str(attempt_dir.resolve())) > 170:
+        raise ValueError("Use an attempt directory shorter than 170 characters for Excel staging.")
+    attempt_dir.mkdir(parents=True, exist_ok=True)
+    start = time.monotonic()
+    candidate = attempt_dir / "converted.xlsx"
+    candidate.unlink(missing_ok=True)
+    original_xlsx = _is_xlsx(source) and not force_save
+    # Excel recognizes old formats from content. A short local name also avoids
+    # long paths and archive characters that its file dialogs cannot handle.
+    suffix = source.suffix if 0 < len(source.suffix) <= 8 else ".xls"
+    local_source = attempt_dir / ("input" + suffix)
+    result: Dict[str, Any] = {
+        "status": "review", "source_sha256": _sha256(source),
+        "method": "copy_xlsx" if original_xlsx else "excel_save_as_xlsx",
+        "options": {"update_links": 0, "read_only": True, "calculation": "manual",
+                    "macros": "disabled", "events": False, "repair": False,
+                    "open_password": "empty", "write_password": "empty", "local": True,
+                    "verify_display_alerts": True},
+        "phases": {},
+    }
+    try:
+        if original_xlsx:
+            shutil.copyfile(source, candidate)
+        else:
+            shutil.copyfile(source, local_source)
+            conversion = _invoke_phase("convert", local_source, candidate, attempt_dir / "convert",
+                                       executable, stage_timeout, max(0.1, total_timeout - (time.monotonic() - start)))
+            result["phases"]["convert"] = conversion
+            if conversion["status"] != "accepted":
+                result.update({key: conversion[key] for key in ("reason", "stage", "error") if key in conversion})
+                return result
+            result["macros_removed"] = conversion.get("macros_removed", False)
+            result["excel"] = conversion.get("excel", {})
+        container_error = _check_xlsx(candidate)
+        if container_error:
+            result.update(reason="invalid_xlsx", stage="package_check", error=container_error)
+            return result
+        remaining = total_timeout - (time.monotonic() - start)
+        if remaining <= 0:
+            result.update(reason="total_timeout", stage="verify", error="No time remains for the reopen check.")
+            return result
+        verification = _invoke_phase("verify", candidate, candidate, attempt_dir / "verify",
+                                     executable, stage_timeout, remaining)
+        result["phases"]["verify"] = verification
+        if verification["status"] != "accepted":
+            result.update({key: verification[key] for key in ("reason", "stage", "error") if key in verification})
+            return result
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        pending = destination.with_name(destination.name + ".pending")
+        shutil.copyfile(candidate, pending)
+        os.replace(str(pending), str(destination))
+        result.update(status="accepted", reason="opened_without_blocking_dialog", stage="complete",
+                      output_sha256=_sha256(destination), output_bytes=destination.stat().st_size,
+                      excel=verification.get("excel", {}),
+                      prompt_check="fresh_excel_instance_with_display_alerts")
+        return result
+    except ExcelInfrastructureError as error:
+        result.update(reason="infrastructure_error", stage=error.details.get("stage", "startup"),
+                      error=str(error), infrastructure=error.details)
+        raise
+    finally:
+        result["elapsed_seconds"] = time.monotonic() - start
+        _write_json(attempt_dir / "result.json", result)
+        local_source.unlink(missing_ok=True)
+        if result["status"] == "accepted":
+            candidate.unlink(missing_ok=True)
diff --git a/src/excel_shrink_research/enron/excel_benchmark.py b/src/excel_shrink_research/enron/excel_benchmark.py
new file mode 100644
index 0000000..e53555d
--- /dev/null
+++ b/src/excel_shrink_research/enron/excel_benchmark.py
@@ -0,0 +1,48 @@
+import json
+import time
+from pathlib import Path
+
+from .common import RunLock, long_path, sha256, utc_now, write_json
+from .excel import convert_file
+from .release import accepted_outputs
+
+
+def benchmark_excel(root, destination, stage_timeout=120, total_timeout=420):
+    """Measure Excel SaveAs on the same frozen XLSX inputs used by Rust."""
+    root, destination = Path(root).resolve(), Path(destination).resolve()
+    with RunLock(root):
+        if destination.exists():
+            raise ValueError("Use a new Excel benchmark directory.")
+        inputs = accepted_outputs(root)
+        destination.mkdir(parents=True)
+        write_json(destination / "run.json", {
+            "started_utc": utc_now(), "input_manifest_sha256": sha256(root / "conversions.jsonl"),
+            "input_files": len(inputs), "workers": 1,
+            "policy": "Fresh Excel instance per input; manual calculation, no link updates. Reopen validation is timed separately.",
+        })
+        counters = {"accepted": 0, "review": 0}
+        times = {"open_seconds": 0, "save_seconds": 0, "convert_seconds": 0, "verify_seconds": 0}
+        started = time.perf_counter()
+        with (destination / "results.jsonl").open("w", encoding="utf-8") as stream:
+            for index, (relative, digest) in enumerate(sorted(inputs.items())):
+                attempt = destination / "_work" / ("{:06d}".format(index))
+                result = convert_file(long_path(root / relative), long_path(destination / relative), attempt,
+                                      stage_timeout=stage_timeout, total_timeout=total_timeout, force_save=True)
+                counters[result["status"]] += 1
+                convert = result.get("phases", {}).get("convert", {})
+                verify = result.get("phases", {}).get("verify", {})
+                times["open_seconds"] += convert.get("timings", {}).get("open", 0)
+                times["save_seconds"] += convert.get("timings", {}).get("save", 0)
+                times["convert_seconds"] += convert.get("elapsed_seconds", 0)
+                times["verify_seconds"] += verify.get("elapsed_seconds", 0)
+                stream.write(json.dumps({"input_path": relative, "input_sha256": digest, "result": result}) + "\n")
+                stream.flush()
+                if (index + 1) % 100 == 0:
+                    print("Excel SaveAs: {}/{} files".format(index + 1, len(inputs)), flush=True)
+        write_json(destination / "summary.json", {
+            **counters, **times, "wall_seconds": time.perf_counter() - started,
+            "timing_note": "Wall time includes worker startup, staging, and reopen validation; use the separate phase totals when reporting COM Open and SaveAs.",
+        })
+        if counters["review"]:
+            raise RuntimeError("Some Excel SaveAs inputs need review; see results.jsonl.")
+        print("Excel benchmark complete: " + str(destination))
diff --git a/src/excel_shrink_research/enron/excel_worker.ps1 b/src/excel_shrink_research/enron/excel_worker.ps1
new file mode 100644
index 0000000..674515b
--- /dev/null
+++ b/src/excel_shrink_research/enron/excel_worker.ps1
@@ -0,0 +1,133 @@
+param([Parameter(Mandatory = $true)][string]$ConfigPath)
+
+$ErrorActionPreference = 'Stop'
+$config = Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json
+$directory = $config.directory
+$utf8 = New-Object Text.UTF8Encoding($false)
+$stage = 'startup'
+$timings = [ordered]@{}
+$stageTimer = [Diagnostics.Stopwatch]::StartNew()
+$owned = $null
+$excel = $null
+$native = $null
+$workbook = $null
+$result = [ordered]@{ status = 'review'; stage = 'startup'; timings = $timings }
+
+function Write-Json([string]$path, $value) {
+    $temporary = $path + '.tmp'
+    [IO.File]::WriteAllText($temporary, ($value | ConvertTo-Json -Depth 12), $utf8)
+    for ($attempt = 0; $attempt -lt 30; $attempt++) {
+        try {
+            if (Test-Path -LiteralPath $path) {
+                [IO.File]::Replace($temporary, $path, [NullString]::Value)
+            } else {
+                [IO.File]::Move($temporary, $path)
+            }
+            return
+        } catch [IO.IOException] {
+            if ($attempt -eq 29) { throw }
+            Start-Sleep -Milliseconds 10
+        }
+    }
+}
+
+function Set-Stage([string]$name) {
+    $script:timings[$script:stage] = $script:stageTimer.Elapsed.TotalSeconds
+    $script:stage = $name
+    $script:stageTimer.Restart()
+    Write-Json (Join-Path $directory 'stage.json') @{ stage = $name; updated_utc = [DateTime]::UtcNow.ToString('o') }
+}
+
+function Open-Workbook([string]$path) {
+    $missing = [Type]::Missing
+    # Empty passwords fail explicitly instead of asking for input. Normal load
+    # does not repair a workbook. The recorded locale governs legacy text imports.
+    return $excel.Workbooks.Open($path, 0, $true, $missing, '', '', $true,
+        $missing, $missing, $false, $false, $missing, $false, $true)
+}
+
+try {
+    Write-Json (Join-Path $directory 'stage.json') @{ stage = 'startup'; updated_utc = [DateTime]::UtcNow.ToString('o') }
+    Add-Type -Path (Join-Path $PSScriptRoot 'OwnedExcel.cs')
+    $owned = New-Object OwnedExcel($config.excel, $config.seed)
+    Write-Json (Join-Path $directory 'process.json') @{
+        pid = $owned.Pid; created_filetime = $owned.CreatedFileTime
+    }
+    while ($null -eq $native) {
+        $native = $owned.FindNativeWindow()
+        if ($null -eq $native) { Start-Sleep -Milliseconds 100 }
+    }
+    $excel = $native.Application
+    $attachedPid = [uint32]0
+    [void][OwnedExcel]::GetWindowThreadProcessId([IntPtr]$excel.Hwnd, [ref]$attachedPid)
+    if ($attachedPid -ne $owned.Pid) { throw 'The Excel window does not belong to this worker.' }
+
+    Set-Stage 'configure'
+    $excel.Visible = $false
+    $excel.DisplayAlerts = ($config.mode -eq 'verify')
+    $excel.AskToUpdateLinks = $false
+    $excel.AutomationSecurity = 3
+    $excel.EnableEvents = $false
+    $excel.Calculation = -4135
+    $excel.CalculateBeforeSave = $false
+    $result.excel = [ordered]@{
+        version = [string]$excel.Version
+        build = [string]$excel.Build
+        operating_system = [string]$excel.OperatingSystem
+        locale = [Globalization.CultureInfo]::CurrentCulture.Name
+        ui_locale = [Globalization.CultureInfo]::CurrentUICulture.Name
+    }
+
+    Set-Stage 'open'
+    $callTimer = [Diagnostics.Stopwatch]::StartNew()
+    $workbook = Open-Workbook $config.source
+    $callTimer.Stop()
+    $result.open_seconds = $callTimer.Elapsed.TotalSeconds
+    if ($null -eq $workbook) { throw 'Excel returned no workbook.' }
+    $result.sheet_count = [int]$workbook.Sheets.Count
+    $result.workbook_structure_protected = [bool]$workbook.ProtectStructure
+    if ($config.mode -eq 'convert') {
+        $hasVba = [bool]$workbook.HasVBProject
+        $macroSheets = 0
+        foreach ($sheet in $workbook.Sheets) {
+            try { if ([int]$sheet.Type -in @(3, 4)) { $macroSheets++ } }
+            finally { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($sheet) }
+        }
+        $result.macros_removed = ($hasVba -or ($macroSheets -gt 0))
+        $result.vba_project = $hasVba
+        $result.xlm_sheet_count = $macroSheets
+        Set-Stage 'save'
+        $workbook.CheckCompatibility = $false
+        $callTimer.Restart()
+        $workbook.SaveAs($config.output, 51, '', '', $false, $false)
+        $callTimer.Stop()
+        $result.save_seconds = $callTimer.Elapsed.TotalSeconds
+    }
+    Set-Stage 'close'
+    $workbook.Close($false)
+    [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($workbook)
+    $workbook = $null
+    $excel.DisplayAlerts = $false
+    $excel.Quit()
+    Set-Stage 'complete'
+    $result.status = 'accepted'
+    $result.reason = 'completed'
+} catch {
+    $result.reason = 'excel_error'
+    $result.error = $_.Exception.Message
+    $result.hresult = ('0x{0:X8}' -f ($_.Exception.HResult -band 0xffffffffL))
+    $result.error_type = $_.Exception.GetType().FullName
+    [Console]::Error.WriteLine($result.error)
+} finally {
+    $timings[$stage] = $stageTimer.Elapsed.TotalSeconds
+    $result.stage = $stage
+    Write-Json (Join-Path $directory 'result.json') $result
+    # Closing this handle is independent of Excel's COM response. No user's
+    # Excel process can belong to this private job.
+    if ($null -ne $owned) { $owned.Dispose() }
+    foreach ($reference in @($workbook, $excel, $native)) {
+        if ($null -ne $reference) {
+            try { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($reference) } catch { }
+        }
+    }
+}
diff --git a/src/excel_shrink_research/enron/ingest.py b/src/excel_shrink_research/enron/ingest.py
new file mode 100644
index 0000000..539afe9
--- /dev/null
+++ b/src/excel_shrink_research/enron/ingest.py
@@ -0,0 +1,534 @@
+"""Download the frozen EDRM source set and inventory its spreadsheet attachments."""
+
+import hashlib
+import http.client
+import json
+import os
+from pathlib import Path
+import re
+import struct
+import tempfile
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+import zipfile
+
+
+ITEM = "edrm.enron.email.data.set.v2.xml"
+METADATA_URL = "https://archive.org/metadata/" + ITEM
+EXPECTED_ARCHIVES = 159
+CHUNK_SIZE = 1024 * 1024
+MAX_NESTING = 3
+MAX_NESTED_BYTES = 2 * 1024 * 1024 * 1024
+SPREADSHEET_SUFFIXES = {
+    ".xls", ".xlsx", ".xlsm", ".xlsb", ".xlt", ".xltx", ".xltm", ".xla",
+    ".xlam", ".xlw", ".csv", ".tsv", ".slk", ".sylk", ".dif", ".wks",
+    ".wk1", ".wk3", ".wk4", ".123", ".wq1", ".wb1", ".wb2", ".wb3", ".qpw",
+}
+
+
+class SourceError(RuntimeError):
+    """The source set is incomplete or failed an integrity check."""
+
+
+def _progress(callback, **event):
+    if callback:
+        callback(event)
+
+
+def _write_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(path.name + ".tmp")
+    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def _fingerprint(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode("utf-8")).hexdigest()
+
+
+def _long_path(path):
+    path = Path(path).absolute()
+    text = str(path)
+    if os.name == "nt" and not text.startswith("\\\\?\\"):
+        return Path("\\\\?\\UNC\\" + text[2:] if text.startswith("\\\\") else "\\\\?\\" + text)
+    return path
+
+
+def _request(url, headers=None):
+    return urllib.request.urlopen(
+        urllib.request.Request(url, headers={"User-Agent": "excel-shrink-research/1", **(headers or {})}),
+        timeout=90,
+    )
+
+
+def freeze_sources(root):
+    """Reuse sources.json, or pin the 159 ZIP files in Archive.org metadata."""
+    root = Path(root)
+    path = root / "sources.json"
+    if path.exists():
+        manifest = json.loads(path.read_text(encoding="utf-8"))
+        _validate_manifest(manifest)
+        return manifest
+    with _request(METADATA_URL) as response:
+        raw = response.read()
+    metadata = json.loads(raw)
+    archives = []
+    for item in metadata["files"]:
+        if not item["name"].lower().endswith(".zip"):
+            continue
+        archives.append({
+            "name": item["name"], "size": int(item["size"]),
+            "md5": item.get("md5"), "sha1": item.get("sha1"),
+            "url": "https://archive.org/download/" + ITEM + "/" + urllib.parse.quote(item["name"], safe=""),
+        })
+    manifest = {
+        "schema": 1, "item": ITEM, "metadata_url": METADATA_URL,
+        "metadata_sha256": hashlib.sha256(raw).hexdigest(),
+        "archives": sorted(archives, key=lambda entry: entry["name"]),
+    }
+    _validate_manifest(manifest)
+    root.mkdir(parents=True, exist_ok=True)
+    metadata_temporary = root / "source-metadata.json.tmp"
+    metadata_temporary.write_bytes(raw)
+    metadata_temporary.replace(root / "source-metadata.json")
+    _write_json(path, manifest)
+    return manifest
+
+
+def _validate_manifest(manifest):
+    archives = manifest.get("archives", [])
+    if manifest.get("schema") != 1 or manifest.get("item") != ITEM:
+        raise SourceError("The source manifest does not describe the expected EDRM collection.")
+    if len(archives) != EXPECTED_ARCHIVES:
+        raise SourceError("Expected 159 source ZIPs; found %d. Review the source manifest." % len(archives))
+    names = set()
+    for source in archives:
+        name = source["name"]
+        if name.casefold() in names or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*\.zip", name, re.I):
+            raise SourceError("Duplicate or unsupported source archive name: " + name)
+        names.add(name.casefold())
+        if source["size"] <= 0 or not source.get("md5") or not source.get("sha1"):
+            raise SourceError("Missing size or checksums for " + name)
+        if not re.fullmatch(r"[a-fA-F0-9]{32}", source["md5"]) or not re.fullmatch(r"[a-fA-F0-9]{40}", source["sha1"]):
+            raise SourceError("Invalid source checksum for " + name)
+
+
+def _hash_file(path):
+    hashes = {name: hashlib.new(name) for name in ("md5", "sha1", "sha256")}
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(CHUNK_SIZE), b""):
+            for digest in hashes.values():
+                digest.update(chunk)
+    return {name: digest.hexdigest() for name, digest in hashes.items()}
+
+
+def _verify(path, source):
+    if path.stat().st_size != source["size"]:
+        raise SourceError("Incorrect download size for " + source["name"])
+    hashes = _hash_file(path)
+    for algorithm in ("md5", "sha1"):
+        if source.get(algorithm) and hashes[algorithm] != source[algorithm].lower():
+            raise SourceError("%s checksum mismatch for %s" % (algorithm.upper(), source["name"]))
+    return hashes
+
+
+def _download(source, destination, callback, retries=4):
+    partial = destination.with_name(destination.name + ".partial")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    last_error = None
+    for attempt in range(retries):
+        try:
+            offset = partial.stat().st_size if partial.exists() else 0
+            if offset > source["size"]:
+                partial.unlink()
+                offset = 0
+            if offset < source["size"]:
+                headers = {"Range": "bytes=%d-" % offset} if offset else {}
+                with _request(source["url"], headers) as response:
+                    status = getattr(response, "status", 200)
+                    if status == 206:
+                        expected = "bytes %d-" % offset
+                        if not response.headers.get("Content-Range", "").startswith(expected):
+                            raise SourceError("Server returned an unexpected byte range for " + source["name"])
+                    elif status == 200:
+                        offset = 0
+                    else:
+                        raise SourceError("Unexpected HTTP status %s for %s" % (status, source["name"]))
+                    last_update = 0.0
+                    with partial.open("ab" if offset else "wb") as output:
+                        for chunk in iter(lambda: response.read(CHUNK_SIZE), b""):
+                            output.write(chunk)
+                            offset += len(chunk)
+                            if offset > source["size"]:
+                                raise SourceError("Download exceeds the recorded size for " + source["name"])
+                            if time.monotonic() - last_update >= 5:
+                                _progress(callback, event="download", archive=source["name"], completed=offset, total=source["size"])
+                                last_update = time.monotonic()
+            try:
+                hashes = _verify(partial, source)
+            except SourceError:
+                if partial.exists() and partial.stat().st_size >= source["size"]:
+                    partial.unlink()
+                raise
+            partial.replace(destination)
+            return hashes
+        except (OSError, SourceError, urllib.error.URLError, http.client.HTTPException) as error:
+            last_error = error
+            _progress(callback, event="download_retry", archive=source["name"], attempt=attempt + 1, message=str(error))
+            if attempt + 1 < retries:
+                time.sleep(min(30, 2 ** attempt))
+    raise SourceError("Download failed after %d attempts: %s (%s)" % (retries, source["name"], last_error))
+
+
+def download_sources(root, manifest, on_progress=None):
+    """Resume interrupted downloads and verify their recorded MD5 and SHA-1."""
+    root = Path(root)
+    for index, source in enumerate(manifest["archives"]):
+        destination = root / "raw" / source["name"]
+        receipt_path = root / "raw" / ".verified" / (source["name"] + ".json")
+        receipt = json.loads(receipt_path.read_text(encoding="utf-8")) if receipt_path.exists() else {}
+        stamp = {"source": _fingerprint(source)}
+        if destination.exists():
+            stat = destination.stat()
+            stamp.update(size=stat.st_size, mtime_ns=stat.st_mtime_ns)
+        if not destination.exists() or any(receipt.get(key) != value for key, value in stamp.items()):
+            if destination.exists():
+                hashes = _verify(destination, source)
+            else:
+                hashes = _download(source, destination, on_progress)
+            stat = destination.stat()
+            stamp.update(size=stat.st_size, mtime_ns=stat.st_mtime_ns, **hashes)
+            _write_json(receipt_path, stamp)
+        _progress(on_progress, event="archive_downloaded", archive=source["name"], completed=index + 1, total=len(manifest["archives"]))
+
+
+def _escape_component(component):
+    if not component:
+        return "%00"
+    escaped = ""
+    for index, char in enumerate(component):
+        unsafe = ord(char) < 32 or char in '%<>:"/\\|?*' or (index >= len(component.rstrip(" .")) and char in " .")
+        escaped += "%%%02X" % ord(char) if unsafe else char
+    if re.match(r"^(CON|PRN|AUX|NUL|COM[1-9¹²³]|LPT[1-9¹²³])(?:\.|$)", escaped, re.I):
+        escaped = "%%%02X" % ord(escaped[0]) + escaped[1:]
+    if len(escaped.encode("utf-16-le")) > 320:
+        shortened = escaped[:120]
+        while len(shortened.encode("utf-16-le")) > 240:
+            shortened = shortened[:-1]
+        escaped = shortened + "~" + hashlib.sha256(component.encode("utf-8")).hexdigest()[:20]
+    return escaped
+
+
+class _Paths:
+    """Keep a readable tree; inventory paths record every escaped name and collision."""
+
+    def __init__(self):
+        self.files = set()
+        self.directories = set()
+
+    def allocate(self, parts, entry_id):
+        output = []
+        for part in parts[:-1]:
+            name = _escape_component(part)
+            key = "/".join(output + [name]).casefold()
+            if key in self.files:
+                name += "~" + entry_id
+                while "/".join(output + [name]).casefold() in self.files:
+                    name += "~"
+            output.append(name)
+            self.directories.add("/".join(output).casefold())
+        name = _escape_component(parts[-1])
+        key = "/".join(output + [name]).casefold()
+        if key in self.files or key in self.directories:
+            suffix = Path(name).suffix
+            stem = name[:-len(suffix)] if suffix else name
+            name = stem + "~" + entry_id + suffix
+            number = 1
+            while "/".join(output + [name]).casefold() in self.files | self.directories:
+                name = stem + "~" + entry_id + "-%d" % number + suffix
+                number += 1
+        output.append(name)
+        self.files.add("/".join(output).casefold())
+        return Path(*output)
+
+
+def _ole_names(path):
+    """Read the CFB directory, without loading workbook streams or invoking Office."""
+    with path.open("rb") as stream:
+        header = stream.read(512)
+        if len(header) != 512:
+            raise ValueError("Truncated OLE header")
+        shift = struct.unpack_from("<H", header, 30)[0]
+        if shift not in (9, 12):
+            raise ValueError("Unsupported OLE sector size")
+        sector_size = 1 << shift
+        sector_count = max(0, path.stat().st_size // sector_size - 1)
+
+        def sector(number):
+            if number >= sector_count:
+                raise ValueError("OLE sector outside the file")
+            stream.seek((number + 1) * sector_size)
+            return stream.read(sector_size)
+
+        fat_ids = list(struct.unpack_from("<109I", header, 76))
+        difat = struct.unpack_from("<I", header, 68)[0]
+        visited = set()
+        while difat < 0xFFFFFFFA:
+            if difat in visited:
+                raise ValueError("Cyclic OLE allocation table")
+            visited.add(difat)
+            values = struct.unpack("<%dI" % (sector_size // 4), sector(difat))
+            fat_ids.extend(values[:-1])
+            difat = values[-1]
+        fat = []
+        for number in fat_ids:
+            if number < 0xFFFFFFFA:
+                fat.extend(struct.unpack("<%dI" % (sector_size // 4), sector(number)))
+        directory = struct.unpack_from("<I", header, 48)[0]
+        names = set()
+        visited.clear()
+        while directory < 0xFFFFFFFA:
+            if directory in visited or directory >= len(fat):
+                raise ValueError("Invalid OLE directory chain")
+            visited.add(directory)
+            data = sector(directory)
+            for offset in range(0, sector_size, 128):
+                length = struct.unpack_from("<H", data, offset + 64)[0]
+                if 2 <= length <= 64 and data[offset + 66] in (1, 2, 5):
+                    names.add(data[offset:offset + length - 2].decode("utf-16-le", errors="replace").casefold())
+            directory = fat[directory]
+        return names
+
+
+def _detect(prefix, name, path=None):
+    suffix = Path(name).suffix.lower()
+    if prefix.startswith(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1"):
+        if path is None:
+            return "ole", "ambiguous", "Inspect the OLE directory."
+        try:
+            names = _ole_names(path)
+        except (ValueError, OSError, struct.error) as error:
+            return "ole", "ambiguous", "OLE directory could not be read: " + str(error)
+        if "workbook" in names or "book" in names:
+            return "xls", "candidate", "OLE Workbook or Book stream."
+        if "encryptedpackage" in names:
+            return "encrypted-office", "ambiguous", "Encrypted Office package; its document type is unknown."
+        if "worddocument" in names or "powerpoint document" in names:
+            return "other-office", "other", "OLE Word or PowerPoint document."
+        return "ole", "ambiguous", "OLE container without an identified document stream."
+    if prefix.startswith((b"PK\x03\x04", b"PK\x05\x06", b"PK\x07\x08")):
+        if path is None:
+            return "zip", "ambiguous", "Inspect the ZIP package."
+        try:
+            with zipfile.ZipFile(path) as package:
+                entries = package.infolist()
+                if any(entry.flag_bits & 1 for entry in entries):
+                    return "encrypted-archive", "ambiguous", "Encrypted ZIP members; the original archive is retained for review."
+                names = {entry.filename.replace("\\", "/").lower() for entry in entries}
+                if "xl/workbook.bin" in names:
+                    return "xlsb", "candidate", "Office binary workbook package."
+                if "xl/workbook.xml" in names:
+                    kind = "xlsm" if "xl/vbaproject.bin" in names else "xlsx"
+                    return kind, "candidate", "Office workbook package."
+                if "word/document.xml" in names or "ppt/presentation.xml" in names:
+                    return "other-office", "other", "Office Word or PowerPoint package."
+                if "mimetype" in names:
+                    entry = next(entry for entry in entries if entry.filename.lower() == "mimetype")
+                    if entry.file_size < 256 and b"opendocument.spreadsheet" in package.read(entry):
+                        return "ods", "candidate", "OpenDocument spreadsheet package."
+        except (OSError, zipfile.BadZipFile, RuntimeError) as error:
+            return "zip", "ambiguous", "ZIP package could not be read: " + str(error)
+        return "zip", "container", "Nested ZIP archive."
+    if prefix[:2] in (b"\x09\x00", b"\x09\x02", b"\x09\x04", b"\x09\x08") and len(prefix) >= 4:
+        return "biff", "candidate", "BIFF beginning-of-file record."
+    if prefix[:4] in (b"\x00\x00\x02\x00", b"\x00\x00\x1a\x00"):
+        return "lotus", "candidate", "Lotus workbook header."
+    if prefix.startswith((b"%PDF", b"\x89PNG", b"GIF87a", b"GIF89a", b"\xff\xd8\xff", b"MZ", b"BM", b"{\\rtf")):
+        return "other", "other", "Recognized non-spreadsheet signature."
+    if prefix.startswith((b"Rar!", b"7z\xbc\xaf\x27\x1c", b"\x1f\x8b", b"BZh")):
+        return "archive", "ambiguous", "Nested archive format requires a separate extraction step."
+    if prefix.startswith((b"\xff\xfe", b"\xfe\xff")):
+        text = prefix.decode("utf-16", errors="replace")
+    else:
+        text = prefix.decode("utf-8-sig", errors="replace")
+    start = text.lstrip()
+    lower = start.lower()
+    if "urn:schemas-microsoft-com:office:spreadsheet" in lower:
+        return "spreadsheetml", "candidate", "Excel SpreadsheetML namespace."
+    if start.startswith("ID;"):
+        return "sylk", "candidate", "SYLK header."
+    if start.startswith("TABLE\n") or start.startswith("TABLE\r\n"):
+        return "dif", "candidate", "Data Interchange Format header."
+    if "urn:schemas-microsoft-com:office:excel" in lower:
+        return "html", "candidate", "Excel HTML namespace."
+    if "<table" in lower and not lower.startswith("<?xml"):
+        return "html", "ambiguous", "HTML table; spreadsheet intent needs review."
+    if suffix in SPREADSHEET_SUFFIXES:
+        return "text" if "\x00" not in text else "unknown", "ambiguous", "Spreadsheet suffix without a recognized workbook signature."
+    lines = [line for line in text.splitlines()[:20] if line.strip()]
+    if len(lines) >= 3 and all("\t" in line for line in lines) and len({line.count("\t") for line in lines}) == 1:
+        return "tsv", "ambiguous", "Consistent tab-separated rows; spreadsheet intent needs review."
+    if lower.startswith(("<?xml", "<", "from:", "received:", "mime-version:")) or (text and "\x00" not in text and text.count("\ufffd") < len(text) // 100 + 1):
+        return "text", "other", "No spreadsheet signature in the first 64 KiB."
+    return "unknown", "ambiguous", "Unrecognized binary content."
+
+
+def _entry_id(archive, chain):
+    return hashlib.sha256((archive + "\0" + "/".join(map(str, chain))).encode("utf-8")).hexdigest()[:24]
+
+
+def _inventory_archive(root, source, output, callback):
+    paths = _Paths()
+    work = root / ".work"
+    work.mkdir(parents=True, exist_ok=True)
+    counts = {"members": 0, "candidate": 0, "ambiguous": 0}
+
+    def scan(path, parent_parts=(), chain=(), member_chain=(), depth=0):
+        with zipfile.ZipFile(path) as archive:
+            for index, info in enumerate(archive.infolist()):
+                member_name = info.orig_filename
+                indices = chain + (index,)
+                entry_id = _entry_id(source["name"], indices)
+                original_parts = parent_parts + tuple(member_name.split("/"))
+                row = {
+                    "id": entry_id, "archive": source["name"], "member": member_name,
+                    "index": index, "member_chain": list(member_chain + (member_name,)),
+                    "index_chain": list(indices), "size": info.file_size, "sha256": None,
+                    "kind": "directory", "classification": "directory", "extracted_path": None,
+                    "attempt_excel": False,
+                }
+                counts["members"] += 1
+                if info.is_dir():
+                    output.write(json.dumps(row, ensure_ascii=True) + "\n")
+                    continue
+                if info.flag_bits & 1:
+                    raise SourceError("Encrypted ZIP member cannot be inventoried: %s / %s" % (source["name"], member_name))
+                symlink = (info.external_attr >> 16) & 0o170000 == 0o120000
+                temporary = None
+                try:
+                    with archive.open(info) as member:
+                        prefix = member.read(65536)
+                        kind, classification, evidence = _detect(prefix, member_name)
+                        retain = classification != "other" or symlink
+                        digest = hashlib.sha256()
+                        total = 0
+                        if retain:
+                            handle = tempfile.NamedTemporaryFile(prefix="member-", suffix=".bin", dir=work, delete=False)
+                            temporary = Path(handle.name)
+                        else:
+                            handle = None
+                        try:
+                            chunk = prefix
+                            while chunk:
+                                digest.update(chunk)
+                                total += len(chunk)
+                                if handle:
+                                    handle.write(chunk)
+                                chunk = member.read(CHUNK_SIZE)
+                        finally:
+                            if handle:
+                                handle.close()
+                    if total != info.file_size:
+                        raise SourceError("Incorrect extracted size for " + member_name)
+                    if temporary and kind in ("ole", "zip"):
+                        kind, classification, evidence = _detect(prefix, member_name, temporary)
+                    if symlink:
+                        kind, classification, evidence = "symlink", "ambiguous", "ZIP symlink stored as regular bytes; it was not followed."
+                    row.update(sha256=digest.hexdigest(), kind=kind, classification=classification, evidence=evidence)
+                    row["attempt_excel"] = not symlink and (
+                        classification == "candidate"
+                        or kind in ("ole", "encrypted-office", "tsv")
+                        or (classification == "ambiguous" and kind not in ("encrypted-archive", "archive") and Path(member_name).suffix.lower() in SPREADSHEET_SUFFIXES)
+                    )
+                    if classification == "container":
+                        if depth >= MAX_NESTING or info.file_size > MAX_NESTED_BYTES:
+                            row.update(classification="ambiguous", evidence="Nested ZIP exceeds the configured depth or size limit.")
+                        else:
+                            row.update(classification="other", nested_status="scanned")
+                            output.write(json.dumps(row, ensure_ascii=True) + "\n")
+                            scan(temporary, original_parts, indices, member_chain + (member_name,), depth + 1)
+                            continue
+                    if row["classification"] in ("candidate", "ambiguous"):
+                        relative = Path("extracted") / _escape_component(source["name"]) / paths.allocate(original_parts, entry_id)
+                        destination = root / relative
+                        destination.parent.mkdir(parents=True, exist_ok=True)
+                        if temporary is None:
+                            raise SourceError("Missing staged data for " + member_name)
+                        temporary.replace(destination)
+                        temporary = None
+                        row["extracted_path"] = relative.as_posix()
+                        counts[row["classification"]] += 1
+                    output.write(json.dumps(row, ensure_ascii=True) + "\n")
+                    if counts["members"] % 250 == 0:
+                        _progress(callback, event="inventory", archive=source["name"], **counts)
+                except (zipfile.BadZipFile, OSError, RuntimeError) as error:
+                    raise SourceError("Cannot inventory %s / %s: %s" % (source["name"], member_name, error)) from error
+                finally:
+                    if temporary and temporary.exists():
+                        temporary.unlink()
+
+    scan(root / "raw" / source["name"])
+    return counts
+
+
+def _checkpoint_valid(root, inventory, marker, stamp):
+    if not inventory.exists() or not marker.exists():
+        return False
+    try:
+        if json.loads(marker.read_text(encoding="utf-8"))["source"] != stamp:
+            return False
+        with inventory.open(encoding="utf-8") as stream:
+            for line in stream:
+                row = json.loads(line)
+                if row.get("extracted_path"):
+                    path = root / row["extracted_path"]
+                    if not path.is_file() or path.stat().st_size != row["size"]:
+                        return False
+    except (OSError, ValueError, KeyError):
+        return False
+    return True
+
+
+def inventory_sources(root, manifest, on_progress=None):
+    """Stream every ZIP member, check CRCs, and retain candidate and ambiguous files.
+
+    The returned JSONL lists every occurrence. Equal candidate bytes retain their
+    source paths and receive duplicate_of, referring to the first occurrence ID.
+    Unknown binary files and unsupported nested archives remain available for review.
+    """
+    root = _long_path(root)
+    directory = root / "inventory"
+    directory.mkdir(parents=True, exist_ok=True)
+    inventories = []
+    for index, source in enumerate(manifest["archives"]):
+        raw = root / "raw" / source["name"]
+        if not raw.is_file() or raw.stat().st_size != source["size"]:
+            raise SourceError("Source archive is missing or incomplete: " + source["name"])
+        stamp = {"manifest": _fingerprint(source), "size": raw.stat().st_size, "mtime_ns": raw.stat().st_mtime_ns, "inventory_schema": 1}
+        inventory = directory / (source["name"] + ".jsonl")
+        marker = directory / (source["name"] + ".complete.json")
+        if not _checkpoint_valid(root, inventory, marker, stamp):
+            temporary = inventory.with_name(inventory.name + ".partial")
+            with temporary.open("w", encoding="utf-8", newline="\n") as output:
+                counts = _inventory_archive(root, source, output, on_progress)
+            temporary.replace(inventory)
+            _write_json(marker, {"source": stamp, "counts": counts})
+        inventories.append(inventory)
+        _progress(on_progress, event="archive_inventoried", archive=source["name"], completed=index + 1, total=len(manifest["archives"]))
+    combined = root / "inventory.jsonl"
+    temporary = combined.with_name(combined.name + ".partial")
+    seen = {}
+    with temporary.open("w", encoding="utf-8", newline="\n") as output:
+        for inventory in inventories:
+            with inventory.open(encoding="utf-8") as stream:
+                for line in stream:
+                    row = json.loads(line)
+                    if row["classification"] in ("candidate", "ambiguous"):
+                        previous = seen.setdefault(row["sha256"], row["id"])
+                        if previous != row["id"]:
+                            row["duplicate_of"] = previous
+                    output.write(json.dumps(row, ensure_ascii=True) + "\n")
+    temporary.replace(combined)
+    return combined
