                "--remove-unreferenced-hidden-content-cells"
            ]
        },
        {
            "name": "Generate Distribution of Size Reduction Chart data.gov (excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/analyze_data_gov_xlsx_files/generate_distribution_of_size_reduction_chart_rust.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap"
        },
        {
            "name": "Verify same values of shrunk data.gov files with original",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/verify_shrunk_xlsx_values/verify_shrunk_xlsx_values.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts\\scrape_data_gov_xlsx_files\\downloaded",
                "scripts\\analyze_data_gov_xlsx_files\\shrinked_by_excel_shrink",
                "--out",
                "scripts\\analyze_data_gov_xlsx_files\\report.json",
            ]
        },
        {
