        },
        {
            "name": "Compare values of shrunk data.gov with original (singlecore)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scape-data-gov-xlsx-files/compare_file_hashes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scape-data-gov-xlsx-files/different",
