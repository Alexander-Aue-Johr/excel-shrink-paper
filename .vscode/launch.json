            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "controller"
            ]
        },
        {
            "name": "Generate Chart Loading Times Size Reduction (only generate chart, no data processing)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/loading_times_size_reduction/loading_times_size_reduction_chart.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
