index 0000000..757e1cb
--- /dev/null
+++ b/src/excel_shrink_research/enron/release.py
@@ -0,0 +1,127 @@
+import json
+import os
+import zipfile
+from collections import Counter
+from pathlib import Path
+
+from .common import RunLock, contained, long_path, read_json, rows, sha256, utc_now, write_json
+
+
+def accepted_outputs(root):
+    root = Path(root).resolve()
+    summary = read_json(root / "summary.json")
+    if summary["limited"]:
+        raise ValueError("Finish preparation before packaging or benchmarking.")
+    for name, key in (
+        ("sources.json", "source_manifest_sha256"),
+        ("inventory.jsonl", "inventory_sha256"),
+        ("conversions.jsonl", "conversion_manifest_sha256"),
+    ):
+        if summary.get(key) != sha256(root / name):
+            raise ValueError("Preparation metadata changed or is incomplete: " + name)
+    candidates = {}
+    inventory_entries = 0
+    for source in rows(root / "inventory.jsonl"):
+        inventory_entries += 1
+        if source["classification"] in ("candidate", "ambiguous"):
+            if source["id"] in candidates:
+                raise ValueError("The inventory repeats an occurrence ID: " + source["id"])
+            candidates[source["id"]] = source
+    outputs = {}
+    seen = set()
+    counts = Counter()
+    accepted_contents = {}
+    for row in rows(root / "conversions.jsonl"):
+        source = row["source"]
+        identifier = source["id"]
+        if identifier in seen or identifier not in candidates:
+            raise ValueError("The conversion manifest repeats or adds an occurrence: " + identifier)
+        if source != candidates[identifier]:
+            raise ValueError("The conversion source differs from its inventory entry: " + identifier)
+        seen.add(identifier)
+        result = row["result"]
+        if result["status"] not in ("accepted", "review"):
+            raise ValueError("An occurrence has no final conversion outcome: " + identifier)
+        counts[result["status"]] += 1
+        if result["status"] == "accepted":
+            relative, digest = result["output_path"], result["output_sha256"]
+            contained(root, relative).relative_to(root / "xlsx")
+            if relative in outputs and outputs[relative] != digest:
+                raise ValueError("An output has conflicting checksums: " + relative)
+            previous = accepted_contents.setdefault(source["sha256"], (relative, digest))
+            if previous != (relative, digest):
+                raise ValueError("Duplicate input contents map to different outputs: " + identifier)
+            outputs[relative] = digest
+    if seen != set(candidates):
+        raise ValueError("The conversion manifest is missing inventory occurrences.")
+    expected_counts = {
+        "inventory_entries": inventory_entries,
+        "candidate_occurrences": len(candidates),
+        "accepted_occurrences": counts["accepted"],
+        "review_occurrences": counts["review"],
+    }
+    if any(summary.get(key, 0) != count for key, count in expected_counts.items()):
+        raise ValueError("The occurrence counts and preparation summary disagree.")
+    if len(outputs) != summary["unique_accepted"]:
+        raise ValueError("The conversion manifest and summary disagree.")
+    if len(accepted_contents) != len(outputs):
+        raise ValueError("Different input contents share an output path.")
+    if not outputs:
+        raise ValueError("There are no accepted XLSX files.")
+    for relative, digest in outputs.items():
+        if sha256(contained(root, relative)) != digest:
+            raise ValueError("A converted output changed: " + relative)
+    actual = {
+        path.relative_to(long_path(root)).as_posix()
+        for path in long_path(root / "xlsx").rglob("*") if path.is_file()
+    }
+    if actual != set(outputs):
+        raise ValueError("The XLSX directory contains unaccounted files. Review it before proceeding.")
+    return outputs
+
+
+def package(root, destination):
+    root, destination = Path(root).resolve(), Path(destination).resolve()
+    with RunLock(root):
+        if destination.exists():
+            raise ValueError("Choose a new archive name; published versions are not overwritten.")
+        outputs = accepted_outputs(root)
+        summary = read_json(root / "summary.json")
+        metadata = {
+            "created_utc": utc_now(), "scope": summary["scope"],
+            "source_manifest_sha256": sha256(root / "sources.json"),
+            "conversion_manifest_sha256": sha256(root / "conversions.jsonl"),
+            "summary": summary,
+            "validation": "Fresh Excel COM reopen in the recorded Windows/Excel environment. No claim about other installations.",
+            "normalization": "Excel SaveAs XLSX; VBA and other unsupported features may be lost. Originals remain in the source archives.",
+        }
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        pending = destination.with_suffix(destination.suffix + ".partial")
+        with zipfile.ZipFile(pending, "w", zipfile.ZIP_DEFLATED, compresslevel=6, allowZip64=True) as archive:
+            for relative in sorted(outputs):
+                archive.write(long_path(contained(root, relative)), relative)
+            for name in ("sources.json", "inventory.jsonl", "conversions.jsonl", "summary.json"):
+                archive.write(root / name, "metadata/" + name)
+            for path in sorted((root / "state" / "code").glob("*.json")):
+                archive.write(path, "metadata/code/" + path.name)
+            for path in sorted((root / "runs").glob("*/run.json")):
+                archive.write(path, "metadata/runs/" + path.parent.name + "/run.json")
+            archive.writestr("metadata/release.json", json.dumps(metadata, indent=2) + "\n")
+            checksums = "".join("{}  {}\n".format(digest, path) for path, digest in sorted(outputs.items()))
+            archive.writestr("SHA256SUMS", checksums)
+            archive.writestr("README.txt", (
+                "Enron spreadsheets normalized with Microsoft Excel\n\n"
+                "This release reconstructs spreadsheet candidates from the frozen EDRM v2 XML archive list.\n"
+                "It does not represent every document ever held by Enron.\n"
+                "xlsx/ contains one file per accepted distinct input content.\n"
+                "metadata/conversions.jsonl maps every candidate occurrence to its output or exception.\n"
+                "Duplicate occurrences retain their source paths in that manifest.\n"
+                "Unresolved formats and failed conversions remain explicit exceptions.\n"
+                "Excel conversion can change workbook features; this is a normalized research input.\n"
+                "The source manifest identifies the original archives. No new license is assigned to their contents.\n"
+            ))
+        os.replace(pending, destination)
+        digest = sha256(destination)
+        destination.with_suffix(destination.suffix + ".sha256").write_text(digest + "  " + destination.name + "\n", encoding="ascii")
+        write_json(destination.with_suffix(destination.suffix + ".json"), {**metadata, "archive_sha256": digest})
+        print("Archive ready: " + str(destination))
diff --git a/src/excel_shrink_research/enron/workflow.py b/src/excel_shrink_research/enron/workflow.py
new file mode 100644
index 0000000..916cef7
--- /dev/null
+++ b/src/excel_shrink_research/enron/workflow.py
@@ -0,0 +1,191 @@
+import hashlib
+import json
+import os
+import shutil
+import time
+from collections import Counter
+from pathlib import Path
+
+from .common import RunLock, contained, long_path, read_json, rows, sha256, utc_now, write_json
+from .excel import convert_file, preflight
+from .ingest import download_sources, freeze_sources, inventory_sources
+
+
+class StopRequested(Exception):
+    pass
+
+
+class Progress:
+    def __init__(self, root):
+        self.root = root
+        self.last = 0
+        self.last_print = 0
+        self.stage = None
+
+    def check_stop(self):
+        if (self.root / "stop.request").exists():
+            raise StopRequested()
+
+    def __call__(self, event):
+        self.check_stop()
+        now = time.monotonic()
+        stage = event.get("event", event.get("stage", "working"))
+        if now - self.last < 2 and stage == self.stage:
+            return
+        write_json(self.root / "status.json", {
+            "state": "running", "pid": os.getpid(), "updated_utc": utc_now(), **event,
+        })
+        if stage != self.stage or now - self.last_print > 30:
+            message = event.get("message", stage.replace("_", " "))
+            archive = event.get("archive", "")
+            completed, total = event.get("completed"), event.get("total")
+            count = " ({}/{})".format(completed, total) if completed is not None else ""
+            print("{}  {}{} {}".format(utc_now(), message, count, archive).rstrip(), flush=True)
+            self.last_print = now
+        self.last, self.stage = now, stage
+
+
+def copy_for_review(root, row, result):
+    source_path = row.get("extracted_path")
+    if source_path:
+        source = contained(root, source_path)
+        relative = source.relative_to(root / "extracted")
+        target = root / "review" / "files" / relative
+        long_path(target.parent).mkdir(parents=True, exist_ok=True)
+        if not long_path(target).exists() or sha256(target) != row["sha256"]:
+            shutil.copyfile(long_path(source), long_path(target))
+        review_path = target.relative_to(root).as_posix()
+    else:
+        review_path = None
+    write_json(root / "review" / "issues" / (row["id"] + ".json"), {
+        "source": row, "review_path": review_path, "result": result,
+    })
+
+
+def prepare(root, config, retry_review=False, limit=None, code_record=None):
+    root = Path(root).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    progress = Progress(root)
+    with RunLock(root):
+        (root / "stop.request").unlink(missing_ok=True)
+        started = time.monotonic()
+        record = {
+            "started_utc": utc_now(), "pid": os.getpid(), "config": config,
+            "code": read_json(code_record) if code_record else None,
+        }
+        run_path = root / "runs" / (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + str(os.getpid()))
+        write_json(run_path / "run.json", record)
+        try:
+            record["host"] = preflight()
+            write_json(run_path / "run.json", record)
+            progress({"event": "sources", "message": "Checking the source manifest"})
+            manifest = freeze_sources(root)
+            if manifest.get("item", manifest.get("identifier", config["source_item"])) != config["source_item"]:
+                raise ValueError("The source manifest and experiment configuration disagree.")
+            if len(manifest["archives"]) != config["expected_archives"]:
+                raise ValueError("Unexpected archive count; review the source manifest.")
+            download_sources(root, manifest, on_progress=progress)
+            inventory = inventory_sources(root, manifest, on_progress=progress)
+            progress({"event": "conversion", "message": "Converting workbooks with Excel"})
+            summary = convert_inventory(root, inventory, config, progress, retry_review, limit)
+            if not summary["limited"]:
+                summary.update(inventory_sha256=sha256(inventory),
+                               conversion_manifest_sha256=sha256(root / "conversions.jsonl"),
+                               source_manifest_sha256=sha256(root / "sources.json"))
+            summary.update(elapsed_seconds=time.monotonic() - started, finished_utc=utc_now())
+            write_json(root / "summary.json", summary)
+            write_json(run_path / "summary.json", summary)
+            write_json(root / "status.json", {"state": "prepared" if not summary["limited"] else "pilot_complete", **summary})
+            print("Preparation complete. Accepted workbooks: {}. Source entries for review: {}.".format(
+                summary["unique_accepted"], summary["review_occurrences"]), flush=True)
+            return 0
+        except StopRequested:
+            write_json(root / "status.json", {"state": "stopped", "updated_utc": utc_now()})
+            print("Stopped at a checkpoint. Run the same command to resume.", flush=True)
+            return 0
+        except Exception as exc:
+            failure = {"state": "failed", "error": str(exc), "updated_utc": utc_now()}
+            write_json(root / "status.json", failure)
+            write_json(run_path / "failure.json", failure)
+            raise
+
+
+def convert_inventory(root, inventory, config, progress, retry_review=False, limit=None):
+    counts = Counter()
+    unique = {}
+    attempts = 0
+    limited = False
+    code_files = {p.name: sha256(p) for p in sorted(Path(__file__).parent.iterdir())
+                  if p.is_file() and p.suffix in (".py", ".ps1", ".cs")}
+    code_digest = hashlib.sha256(json.dumps(code_files, sort_keys=True).encode()).hexdigest()
+    write_json(root / "state" / "code" / (code_digest + ".json"), code_files)
+    result_path = root / "conversions.jsonl"
+    pending = result_path.with_suffix(".jsonl.partial")
+    total = sum(1 for row in rows(inventory) if row["classification"] in ("candidate", "ambiguous"))
+    with pending.open("w", encoding="utf-8", newline="\n") as output:
+        for row in rows(inventory):
+            counts["inventory_entries"] += 1
+            if row["classification"] not in ("candidate", "ambiguous"):
+                continue
+            progress.check_stop()
+            digest = row.get("sha256")
+            source = contained(root, row["extracted_path"]) if row.get("extracted_path") else None
+            result = unique.get(digest) if digest else None
+            if result is None:
+                state = root / "state" / "conversions" / ((digest or row["id"]) + ".json")
+                if state.exists():
+                    cached = read_json(state)
+                    if cached.get("config") != config:
+                        raise ValueError("Conversion settings changed. Use a new data root to keep results comparable.")
+                    result = cached["result"]
+                    if result["status"] == "accepted":
+                        target = contained(root, result["output_path"])
+                        if not long_path(target).is_file() or sha256(target) != result["output_sha256"]:
+                            raise ValueError("A converted output changed or is missing: " + str(target))
+                    elif retry_review:
+                        result = None
+                if result is None:
+                    if limit is not None and attempts >= limit:
+                        limited = True
+                        break
+                    if source and row.get("attempt_excel", row["classification"] == "candidate"):
+                        if sha256(source) != digest:
+                            raise ValueError("An extracted input changed: " + str(source))
+                        relative = source.relative_to(root / "extracted")
+                        destination = root / "xlsx" / (relative.as_posix() + ".xlsx")
+                        attempt = root / "_work" / (digest[:16] + "-" + str(time.time_ns()))
+                        attempt.mkdir(parents=True)
+                        result = convert_file(long_path(source), long_path(destination), attempt,
+                            stage_timeout=config["stage_timeout_seconds"],
+                            total_timeout=config["file_timeout_seconds"])
+                        attempts += 1
+                        result["attempt_path"] = attempt.relative_to(root).as_posix()
+                        if result["status"] == "accepted":
+                            result["output_path"] = destination.relative_to(root).as_posix()
+                            result["output_sha256"] = sha256(destination)
+                    else:
+                        result = {"status": "review", "reason": "format_review", "evidence": row.get("evidence", row.get("kind"))}
+                    result["converter_code_sha256"] = code_digest
+                    write_json(state, {"source_sha256": digest, "config": config, "result": result})
+                if digest:
+                    unique[digest] = result
+            counts["candidate_occurrences"] += 1
+            counts[result["status"] + "_occurrences"] += 1
+            if result["status"] != "accepted":
+                copy_for_review(root, row, result)
+            else:
+                # Retain old attempt evidence; current issues list only unresolved occurrences.
+                (root / "review" / "issues" / (row["id"] + ".json")).unlink(missing_ok=True)
+            output.write(json.dumps({"source": row, "result": result}, ensure_ascii=True) + "\n")
+            output.flush()
+            progress({"event": "conversion", "completed": counts["candidate_occurrences"], "total": total,
+                      "accepted": counts["accepted_occurrences"], "review": counts["review_occurrences"]})
+    if not limited:
+        os.replace(pending, result_path)
+    return {
+        **dict(counts), "review_occurrences": counts["review_occurrences"],
+        "unique_accepted": sum(x["status"] == "accepted" for x in unique.values()),
+        "unique_review": sum(x["status"] != "accepted" for x in unique.values()),
+        "conversion_attempts": attempts, "limited": limited,
+        "scope": "Spreadsheet candidates in the frozen EDRM v2 XML archives; unresolved formats remain listed for review.",
+    }
