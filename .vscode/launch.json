    "version": "0.2.0",
    "configurations": [
        {
            "name": "Compare Excel File Sizes",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/compare_filesizes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "C:/Users/aue-johr/Downloads/old_downloads/data_gov_3nd_dl",
                "C:/Users/aue-johr/Downloads/old_downloads/data_gov_3nd_dl_s",
                "--abs-count",
                "100",
                "--rel-count",
                "100",
            ]
        },
        {
            "name": "Scrape and Download Destatis XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scrape_destatis_xlsx_files/scrape_and_download_destatis_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--crawl_delay",
                "30"
            ]
        },
        {
            "name": "Download Destatis XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scrape_destatis_xlsx_files/scrape_and_download_destatis_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--crawl_delay",
                "30",
                "--seed_from_original_repo",
                "--update_original_repo",
                "--skip_scraping"
            ]
        },
        {
            "name": "Analyze Destatis XLSX Files (excel-shrink-analyzer)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink_analyzer/excel_shrink_analyzer.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--recursive",
                "--log",
                "analysis_output.csv",
                "scripts/scrape_destatis_xlsx_files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_analyzer",
            ]
        },
        {
            "name": "Generate Distribution of Size Reduction Chart",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/analyze_destatis_xlsx_files/generate_distribution_of_size_reduction_chart.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap"
        },
        {
            "name": "Generate Distribution of Size Reduction Chart (excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/analyze_destatis_xlsx_files/generate_distribution_of_size_reduction_chart_rust.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap"
        },
        {
            "name": "Shrink Destatis XLSX Files (excel-shrink)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink/excel_shrink.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scrape_destatis_xlsx_files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_excel_shrink",
                "--recursive",
                "--chunk-size",
                "2097152",
            ]
        },
        {
            "name": "Shrink Destatis XLSX Files (excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink_rust/run_excel_shrink_rust.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scrape_destatis_xlsx_files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_excel_shrink_rust",
                "--recursive",
                "--force-overwrite",
                "--analysis-mode",
                "--analysis-csv",
                "scripts/analyze_destatis_xlsx_files/excel_shrink_rust_analysis.csv",
                "--preprocess-hidden-rows",
                "--preprocess-empty-cells",
                "--remove-unreferenced-whitespace-cells",
                "--remove-unreferenced-hidden-content-cells"
            ]
        },
        {
            "name": "Prepare original Destatis XLSX Files for Comparison (fix corrupt workbook.xml, don't touch sheet files)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink/excel_shrink.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scrape_destatis_xlsx_files/downloaded",
                "scripts/analyze_destatis_xlsx_files/fixed_original_corrupt_destatis_files",
                "--recursive",
                "--only-clean-workbook"
            ]
        },
        {
            "name": "Verify same values of shrunk Destatis files with original",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/verify_shrunk_xlsx_values/verify_shrunk_xlsx_values.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts\\analyze_destatis_xlsx_files\\fixed_original_corrupt_destatis_files",
                "scripts\\analyze_destatis_xlsx_files\\shrinked_by_excel_shrink",
                "--out",
                "scripts\\analyze_destatis_xlsx_files\\report.json",
            ]
        },
        {
            "name": "Verify same values of shrunk Destatis files with original (excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/verify_shrunk_xlsx_values/verify_shrunk_xlsx_values.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts\\analyze_destatis_xlsx_files\\fixed_original_corrupt_destatis_files",
                "scripts\\analyze_destatis_xlsx_files\\shrinked_by_excel_shrink_rust",
                "--out",
                "scripts\\analyze_destatis_xlsx_files\\report_rust.json"
            ]
        },
        {
            "name": "Compare Excel File Sizes (Destatis excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/compare_filesizes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scrape_destatis_xlsx_files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_excel_shrink_rust",
                "--abs-count",
                "100",
                "--rel-count",
                "100"
            ]
        },
        {
            "name": "Scrape and Download Data.gov XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts\\scrape_data_gov_xlsx_files\\scrape_and_download_data_gov_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--scrape",
                "--out",
                "scripts\\scrape_data_gov_xlsx_files\\"
            ]
        },
        {
            "name": "Download Data.gov XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts\\scrape_data_gov_xlsx_files\\scrape_and_download_data_gov_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--out",
                "scripts\\scrape_data_gov_xlsx_files\\"
            ]
        },
         {
            "name": "Shrink data.gov XLSX Files (excel-shrink)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink/excel_shrink.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "scripts/scrape_data_gov_xlsx_files/downloaded",
                "scripts/analyze_data_gov_xlsx_files/shrinked_by_excel_shrink",
                "--recursive",
                "--chunk-size",
                "2097152",
            ]
        },
        {
            "name": "Shrink data.gov XLSX Files (excel-shrink-rust)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink_rust/run_excel_shrink_rust.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "K:/original_data_gov_xlsx_files",
                "K:/shrunk_data_gov_xlsx_files_rust",
