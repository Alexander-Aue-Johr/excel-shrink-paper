{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Compare Excel File Sizes",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/compare_filesizes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "R:/o",
                "R:/d",
                "--abs-count",
                "3",
                "--rel-count",
                "3",
            ]
        },
        {
            "name": "Scrape and Download Destatis XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scrape-destatis-xlsx-files/scrape_and_download_destatis_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--crawl_delay",
                "30"
            ]
        },
        {
            "name": "Download Destatis XLSX Files",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/scrape-destatis-xlsx-files/scrape_and_download_destatis_xlsx_files.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--crawl_delay",
                "30",
                "--skip_scraping"
            ]
        },
        {
            "name": "Analyze Destatis XLSX Files (excel-shrink-analyzer)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink_analyzer/excel_shrink_analyzer.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--recursive",
                "--log",
                "analysis_output.csv",
                "scripts/scrape-destatis-xlsx-files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_analyzer",
            ]
        },
        {
            "name": "Generate Distribution of Size Reduction Chart",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/analyze_destatis_xlsx_files/generate_distribution_of_size_reduction_chart.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap"
        },
        {
            "name": "Shrink Destatis XLSX Files (excel-shrink)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/excel_shrink/excel_shrink.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "--recursive",
                "--chunk-size",
                "2097152",
                "scripts/scrape-destatis-xlsx-files/downloaded",
                "scripts/analyze_destatis_xlsx_files/shrinked_by_excel_shrink",
            ]
        },
        {
            "name": "Generate Chart Loading Times Size Reduction",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/loading_times_size_reduction/loading_times_size_reduction_chart.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "controller"
            ]
        },
        {
            "name": "Generate Chart Loading Times Size Reduction (only generate chart, no data processing)",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/loading_times_size_reduction/loading_times_size_reduction_chart.py",
            "python": "${workspaceFolder}/.venv/Scripts/python",
            "preLaunchTask": "py:bootstrap",
            "args": [
                "controller",
                "--no-run-tests"
            ]
        }
    ]
}